{
  "$id": "urn:lattice:schemas:license-scope:v2.1",
  "title": "Lattice license scope manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "copyrightHolder",
    "requiredNotice",
    "scopes"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/license-scope.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "copyrightHolder": {
      "const": "Hayden Howard"
    },
    "requiredNotice": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register-exclusive",
        "engine-proprietary",
        "license-administrative",
        "owner-reserved"
      ],
      "properties": {
        "register-exclusive": {
          "$ref": "#/$defs/scope"
        },
        "engine-proprietary": {
          "$ref": "#/$defs/scope"
        },
        "license-administrative": {
          "$ref": "#/$defs/scope"
        },
        "owner-reserved": {
          "$ref": "#/$defs/reservedScope"
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "terms",
        "files"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reservedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "terms",
        "files",
        "registerFiles"
      ],
      "properties": {
        "license": {
          "const": "LicenseRef-Hayden-All-Rights-Reserved"
        },
        "terms": {
          "const": "RIGHTS-RESERVED.md"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "registerFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
