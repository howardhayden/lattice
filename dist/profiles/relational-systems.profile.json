{
  "id": "relational-systems",
  "version": "v1.0.0",
  "title": "Relational Systems Register",
  "description": "A context-sensitive register that moves from embodied perception through relational and institutional causality to consequential choice, preserving subtext, focal fallibility, clear action, and causal depth without redundant explanation.",
  "rules": [
    {
      "id": "RSR-CORE-001",
      "revision": "r1",
      "description": "Remove redundant explanation without removing causal complexity.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "subtext-redundancy",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": { "threshold": 0.76 }
    },
    {
      "id": "RSR-CORE-002",
      "revision": "r1",
      "description": "Condition diction and cadence on layer, surface, focalizer, stakes, and domain.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-CORE-003",
      "revision": "r1",
      "description": "Distribute register features contextually rather than satisfying fixed stylistic quotas.",
      "norm": "avoid",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "punctuation-restraint",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["ornament"],
      "params": { "maxEmDashesPer1000": 12, "maxParenthesesPer1000": 6, "maxSemicolonsPer1000": 7 }
    },
    {
      "id": "RSR-FOC-001",
      "revision": "r1",
      "description": "Bind narration to the declared focalizer when one is present.",
      "norm": "must",
      "priority": "domain",
      "enforcement": "soft",
      "validatorId": "focal-specificity",
      "appliesWhen": { "exists": { "field": "focalizer.id", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-FOC-002",
      "revision": "r1",
      "description": "Shape perception through focal knowledge, expertise, bias, emotion, and immediate objective.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "advisory",
      "validatorId": "focal-specificity",
      "appliesWhen": { "exists": { "field": "focalizer.id", "value": true } },
      "dependsOn": ["RSR-FOC-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-FOC-003",
      "revision": "r1",
      "description": "Permit persuasive but incorrect focal models without allowing narration to certify them.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "exists": { "field": "focalizer.id", "value": true } },
      "dependsOn": ["RSR-FOC-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-FOC-004",
      "revision": "r1",
      "description": "Keep focal voices distinguishable without relying on names.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "focal-specificity",
      "appliesWhen": { "exists": { "field": "focalizer.id", "value": true } },
      "dependsOn": ["RSR-FOC-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-FLOW-001",
      "revision": "r1",
      "description": "Anchor experiential copy in something perceived, handled, needed, remembered, or physically encountered.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "embodied-anchor",
      "appliesWhen": { "eq": { "field": "layer", "value": "experiential" } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["figurative"],
      "params": {}
    },
    {
      "id": "RSR-FLOW-002",
      "revision": "r1",
      "description": "Let the embodied anchor provoke inquiry into relevant causality.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "eq": { "field": "layer", "value": "experiential" } },
      "dependsOn": ["RSR-FLOW-001"],
      "conflictsWith": [],
      "tags": ["figurative"],
      "params": {}
    },
    {
      "id": "RSR-FLOW-003",
      "revision": "r1",
      "description": "Let inquiry reveal relational, technical, historical, or institutional structure.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "layered-depth",
      "appliesWhen": { "in": { "field": "layer", "value": ["experiential", "interpretive"] } },
      "dependsOn": ["RSR-FLOW-002"],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumLayers": 3, "minimumCausalLinks": 2 }
    },
    {
      "id": "RSR-FLOW-004",
      "revision": "r1",
      "description": "Expose an asymmetry, contradiction, or cost when the scene has consequential stakes.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "soft",
      "validatorId": "externality-presence",
      "appliesWhen": { "in": { "field": "stakes", "value": ["consequential", "urgent", "safety-critical"] } },
      "dependsOn": ["RSR-FLOW-003"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-FLOW-005",
      "revision": "r1",
      "description": "Return understanding to a present choice, action, or consequence.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "layer", "value": ["experiential", "interpretive"] } },
      "dependsOn": ["RSR-FLOW-003"],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-FLOW-006",
      "revision": "r1",
      "description": "Do not let conceptual expansion replace present dramatic action.",
      "norm": "avoid",
      "priority": "clarity",
      "enforcement": "advisory",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-SUB-001",
      "revision": "r1",
      "description": "Prefer dialogue, silence, behavior, timing, omission, and physical response as carriers of relational meaning.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "reflection", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["subtext"],
      "params": {}
    },
    {
      "id": "RSR-SUB-002",
      "revision": "r1",
      "description": "Do not restate an inferable proposition across dialogue, narration, or thought unless the later expression adds evidence, correction, conflict, or reinterpretation.",
      "norm": "avoid",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "subtext-redundancy",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": ["RSR-SUB-001"],
      "conflictsWith": [],
      "tags": ["subtext"],
      "params": { "threshold": 0.76, "noveltyRequired": true }
    },
    {
      "id": "RSR-SUB-003",
      "revision": "r1",
      "description": "Use narration to add privately accessible, suppressed, misread, or newly noticed information.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["reflection", "narration"] } },
      "dependsOn": ["RSR-SUB-001"],
      "conflictsWith": [],
      "tags": ["subtext"],
      "params": {}
    },
    {
      "id": "RSR-SUB-004",
      "revision": "r1",
      "description": "Keep subtext inferable from available evidence without decoding every silence or omission.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "reflection", "narration"] } },
      "dependsOn": ["RSR-SUB-001"],
      "conflictsWith": [],
      "tags": ["subtext"],
      "params": {}
    },
    {
      "id": "RSR-DIA-001",
      "revision": "r1",
      "description": "Give each registered speaker an immediate conversational objective.",
      "norm": "must",
      "priority": "clarity",
      "enforcement": "soft",
      "validatorId": "dialogue-objective",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DIA-002",
      "revision": "r1",
      "description": "Shape each speaker through incomplete knowledge, expertise, status, incentives, and emotional defenses.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation"] } },
      "dependsOn": ["RSR-DIA-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DIA-003",
      "revision": "r1",
      "description": "Let questions, disagreement, interruption, evasion, and partial answers test models and alter conversational control.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation"] } },
      "dependsOn": ["RSR-DIA-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DIA-004",
      "revision": "r1",
      "description": "Do not turn ordinary exchanges into adjacent polished essays or make speakers state conclusions they would leave implicit.",
      "norm": "avoid",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation"] } },
      "dependsOn": ["RSR-DIA-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DIA-005",
      "revision": "r1",
      "description": "Require substantive dialogue to change knowledge, options, power, risk, or attachment.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation"] } },
      "dependsOn": ["RSR-DIA-001"],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-EXP-001",
      "revision": "r1",
      "description": "Introduce exposition under present narrative pressure and link substantial passages to a state change or deferred payoff.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "mode", "value": ["briefing", "analysis", "exposition", "technical", "institutional"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-EXP-002",
      "revision": "r1",
      "description": "Supply only the history or system information presently required to understand a choice, constraint, or consequence.",
      "norm": "prefer",
      "priority": "clarity",
      "enforcement": "advisory",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "mode", "value": ["briefing", "analysis", "exposition", "technical", "institutional"] } },
      "dependsOn": ["RSR-EXP-001"],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-EXP-003",
      "revision": "r1",
      "description": "Prefer procedures, incentives, records, artifacts, and contested accounts over detached institutional summary.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "mode", "value": ["briefing", "analysis", "exposition", "technical", "institutional"] } },
      "dependsOn": ["RSR-EXP-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-EXP-004",
      "revision": "r1",
      "description": "Require lineage and institutional history to affect present status, inheritance, allegiance, causality, or risk.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "mode", "value": ["briefing", "analysis", "exposition", "institutional"] } },
      "dependsOn": ["RSR-EXP-001"],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-EXP-005",
      "revision": "r1",
      "description": "Do not arrest scene movement with dossiers, name cascades, or decorative research.",
      "norm": "avoid",
      "priority": "clarity",
      "enforcement": "advisory",
      "validatorId": "exposition-state-change",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumWords": 60 }
    },
    {
      "id": "RSR-DEP-001",
      "revision": "r1",
      "description": "Give major scenes multiple relevant narrative layers connected by causal edges.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "layered-depth",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumLayers": 3, "minimumCausalLinks": 2 }
    },
    {
      "id": "RSR-DEP-002",
      "revision": "r1",
      "description": "Keep one clear present dramatic line while bodily, cognitive, relational, institutional, and ethical layers interact.",
      "norm": "prefer",
      "priority": "clarity",
      "enforcement": "advisory",
      "validatorId": "layered-depth",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": ["RSR-DEP-001"],
      "conflictsWith": [],
      "tags": [],
      "params": { "minimumLayers": 3, "minimumCausalLinks": 2 }
    },
    {
      "id": "RSR-DEP-003",
      "revision": "r1",
      "description": "Revisit events and motifs only when they accumulate, revise, or complicate causal and ethical meaning.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["reflection", "summary", "after-action", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DEP-004",
      "revision": "r1",
      "description": "Preserve unresolved contradictions until evidence or consequence earns resolution.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "layer", "value": ["experiential", "interpretive"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-DEP-005",
      "revision": "r1",
      "description": "Do not use length, obscurity, terminology density, or parallel decoration as evidence of depth.",
      "norm": "avoid",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-RHY-001",
      "revision": "r1",
      "description": "Maintain a readable syntactic foundation with contextual sentence-length variance.",
      "norm": "prefer",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "sentence-variance",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["ornament"],
      "params": { "minimumStandardDeviation": 3, "maximumStandardDeviation": 18 }
    },
    {
      "id": "RSR-RHY-002",
      "revision": "r1",
      "description": "Use cumulative sentences for expanding thought and fragments or repetition only at justified thresholds.",
      "norm": "prefer",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "sentence-variance",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "summary", "after-action", "narration"] } },
      "dependsOn": ["RSR-RHY-001"],
      "conflictsWith": [],
      "tags": ["ornament"],
      "params": { "minimumStandardDeviation": 3, "maximumStandardDeviation": 18 }
    },
    {
      "id": "RSR-RHY-003",
      "revision": "r1",
      "description": "Cluster compression under pressure and slow intimacy through attention rather than ornament alone.",
      "norm": "prefer",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "surface", "value": ["dialogue", "conversation", "transition", "reflection", "narration"] } },
      "dependsOn": ["RSR-RHY-001"],
      "conflictsWith": [],
      "tags": ["ornament"],
      "params": {}
    },
    {
      "id": "RSR-RHY-004",
      "revision": "r1",
      "description": "Preserve visceral intensity and sensory narrowing while retaining causal clarity.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "action-clarity",
      "appliesWhen": { "in": { "field": "mode", "value": ["movement", "care", "action"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["figurative"],
      "params": {}
    },
    {
      "id": "RSR-LEX-001",
      "revision": "r1",
      "description": "Use specialized vocabulary only when supported by focal competence, audience knowledge, or necessary domain context.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "advisory",
      "validatorId": "focal-specificity",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-LEX-002",
      "revision": "r1",
      "description": "Use qualifiers only when they narrow or revise meaning, and prefer precise operational verbs to abstract declarations.",
      "norm": "prefer",
      "priority": "clarity",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-LEX-003",
      "revision": "r1",
      "description": "Do not substitute rare vocabulary for exact meaning or give every focalizer equal articulation under pressure.",
      "norm": "avoid",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "exists": { "field": "layer", "value": true } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-EMB-001",
      "revision": "r1",
      "description": "Materialize abstraction through bodies, tools, labor, food, rooms, documents, weather, light, or temperature.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "soft",
      "validatorId": "embodied-anchor",
      "appliesWhen": { "eq": { "field": "layer", "value": "experiential" } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": ["figurative"],
      "params": {}
    },
    {
      "id": "RSR-EMB-002",
      "revision": "r1",
      "description": "Draw metaphors from the focalizer's actual world and use bodily sensation to carry affect.",
      "norm": "prefer",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "embodied-anchor",
      "appliesWhen": { "eq": { "field": "layer", "value": "experiential" } },
      "dependsOn": ["RSR-EMB-001"],
      "conflictsWith": [],
      "tags": ["figurative", "imagery-dependent"],
      "params": {}
    },
    {
      "id": "RSR-EMB-003",
      "revision": "r1",
      "description": "Use objects and spaces as structures of agency, access, safety, memory, and power.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "layer", "value": ["experiential", "interpretive"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-EMB-004",
      "revision": "r1",
      "description": "Remove imagery that changes neither perception, causality, nor meaning.",
      "norm": "avoid",
      "priority": "ornament",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "eq": { "field": "layer", "value": "experiential" } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-AFF-001",
      "revision": "r1",
      "description": "Express intimacy through specific attention, labor, teaching, provision, planning, protection, promises, boundaries, or shared work.",
      "norm": "prefer",
      "priority": "register",
      "enforcement": "advisory",
      "validatorId": "manual-review",
      "appliesWhen": { "in": { "field": "mode", "value": ["care", "conversation", "reflection"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-AFF-002",
      "revision": "r1",
      "description": "Preserve agency, boundaries, and reciprocity as live questions where power is unequal.",
      "norm": "prefer",
      "priority": "domain",
      "enforcement": "advisory",
      "validatorId": "externality-presence",
      "appliesWhen": { "in": { "field": "stakes", "value": ["consequential", "urgent", "safety-critical"] } },
      "dependsOn": [],
      "conflictsWith": [],
      "tags": [],
      "params": {}
    },
    {
      "id": "RSR-AFF-003",
      "revision": "r1",
      "description": "Do not assume service, competence, teaching, provision, or protection automatically constitutes healthy care.",
      "norm": "avoid",
      "priority": "register",
      "enforcement": "advisory",
